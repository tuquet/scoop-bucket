{
    "version": "8.0.22",
    "description": "Claude Code CLI with Google Antigravity OAuth integration (Zero API cost & On-Demand Proxy Lifecycle)",
    "homepage": "https://github.com/tuquet/claude-agy",
    "license": "MIT",
    "depends": "nodejs-lts",
    "architecture": {
        "64bit": {
            "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v8.0.22/CLIProxyAPI_8.0.22_windows_amd64.zip",
            "hash": "6d72f785c51e1485b643457d47b2600665fd98b553d84b305423c2c9cd4d41d4"
        }
    },
    "bin": "bin\\claude-agy",
    "persist": [
        "config",
        "data",
        "logs"
    ],
    "pre_install": [
        "$env:TARGET_DIR = $dir",
        "irm https://raw.githubusercontent.com/tuquet/claude-agy/main/scripts/setup.mjs | node"
    ],
    "post_uninstall": "Get-Process cli-proxy-api -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue",
    "checkver": {
        "github": "https://github.com/router-for-me/CLIProxyAPI"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v$version/CLIProxyAPI_$version_windows_amd64.zip",
                "hash": {
                    "url": "$baseurl/checksums.txt"
                }
            }
        }
    }
}
