{
    "version": "0.1.0",
    "description": "Ultra-fast universal distributed execution engine in Rust (tqr / tuquet-runner)",
    "homepage": "https://github.com/tuquet/tuquet-runner",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/tuquet/tuquet-runner/releases/download/v0.1.0/tuquet-runner-v0.1.0-windows-x64.zip",
            "hash": ""
        }
    },
    "bin": [
        "tqr.exe",
        [
            "tqr.exe",
            "tuquet-runner"
        ]
    ],
    "persist": [
        "config",
        "logs"
    ],
    "checkver": {
        "github": "https://github.com/tuquet/tuquet-runner"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/tuquet/tuquet-runner/releases/download/v$version/tuquet-runner-v$version-windows-x64.zip"
            }
        }
    }
}
